programa {
  funcao inicio() {

  cadeia resp,resp2,resp3

  escreva("O Brasil é o pais mais populoso do mundo")
  escreva("\nisso é: ")  leia(resp)

  escreva("2+2X2=6") escreva("\nisso é: ") leia(resp2)

  escreva("programar é divertido")escreva("\nisso é: ") leia(resp3)

  escreva("gabarito: falso,verdadeiro,verdadeiro\n")
  escreva("suas respostas: ",resp,",",resp3,",",resp2,",")

    
  }
}
